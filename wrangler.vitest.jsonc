{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "conference-engine-worker-tests",
	"main": "test/workers/worker.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"secrets": { "required": [] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "conference-engine-worker-tests",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "conference-engine-worker-test-assets"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVENT_ROOM",
				"class_name": "EventRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EventRoom"]
		}
	]
}
